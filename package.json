    "@types/node": "^26.6.4",
    "hono": "^4.13.9",
    "marked": "^18.0.14",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
