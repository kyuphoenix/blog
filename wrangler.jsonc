{
  "name": "blog-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // 静态资源目录（托管 /images/home-bg.webp, /images/avatar.png, favicon 等）
  "assets": {
    "directory": "./public"
  },
  // KV 缓存绑定（用于缓存 GitHub 拉取的文章）
  "kv_namespaces": [
    {
      "binding": "BLOG_CACHE",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],
  // 环境变量（由部署工作流动态从 GitHub 环境变量读取并注入）
  "vars": {
    "GITHUB_OWNER": "<GITHUB_OWNER>",
    "GITHUB_REPO": "<GITHUB_REPO>",
    "GITHUB_BRANCH": "<GITHUB_BRANCH>"
  }
}