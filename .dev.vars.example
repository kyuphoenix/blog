# ==============================================================================
# Cloudflare Worker 本地开发环境变量示例文件 (.dev.vars)
# 使用说明：
# 1. 复制本文件并重命名为 `.dev.vars`：
#    cp .dev.vars.example .dev.vars
# 2. 运行 `pnpm dev` 时，Wrangler 会自动加载 `.dev.vars` 中的变量并注入到 Worker 的 `c.env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub 仓库配置（用于运行时拉取文章 Markdown 及元数据）
# ------------------------------------------------------------------------------
# 仓库所有者（GitHub 用户名或组织名）
GH_OWNER="kyuphoenix"

# 仓库名称
GH_REPO="blog"

# 文章所在分支（默认为 main）
GH_BRANCH="main"

# GitHub 访问令牌（可选，若仓库为私有仓库或为避免 GitHub Raw API 频率限制时配置）
# GH_TOKEN="ghp_xxxx"

# ------------------------------------------------------------------------------
# 2. 博客基础服务配置
# ------------------------------------------------------------------------------
# 博客完整访问地址（本地开发建议为 http://localhost:8787）
BLOG_URL="http://localhost:8787"

# 缓存刷新接口密钥（用于验证 POST /api/posts/purge 请求的 X-Purge-Secret 请求头）
PURGE_SECRET="local-dev-purge-secret"

# ------------------------------------------------------------------------------
# 3. Giscus 评论系统配置（可选，基于 GitHub Discussions）
# ------------------------------------------------------------------------------
# 绑定的公开 GitHub 仓库，格式为 username/repo
# GISCUS_REPO="kyuphoenix/blog"

# Giscus 仓库 ID（访问 https://giscus.app 输入仓库后自动获取）
# GISCUS_REPO_ID="R_xxxx"

# Giscus 讨论分区分类名称（默认为 Announcements）
# GISCUS_CATEGORY="Announcements"

# Giscus 讨论分区分类 ID（在 giscus.app 选择分类后获取）
# GISCUS_CATEGORY_ID="DIC_xxxx"

# Giscus 自定义主题地址（可选，系统默认已自动适配 Fuwari 设计风格并自动切换明暗模式）
# 如需强制指定或使用其他主题，可配置以下两项：
# GISCUS_THEME_LIGHT="https://yourdomain.com/css/giscus-fuwari-light.css"
# GISCUS_THEME_DARK="https://yourdomain.com/css/giscus-fuwari-dark.css"

# ------------------------------------------------------------------------------
# 4. Umami 访问量统计配置（可选，100% 零数据库超轻量方案）
# ------------------------------------------------------------------------------
# 开启后文章卡片将异步展示阅读量徽章，且提供独立的可视化大屏，完全无需 D1 / Supabase
# UMAMI_HOST="https://cloud.umami.is"
# UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. 边缘 CDN 强制缓存失效与 SWR 配置 (可选，配置后支持一键清除全球边缘 CDN)
# ------------------------------------------------------------------------------
# 数据层默认缓存时长（秒，默认 86400 即 24 小时，搭配主动 Purge 彻底杜绝 GitHub 限流）
# CACHE_TTL=86400

# [Cloudflare 全球 CDN 广播清除]
# 域名 Zone ID (在 Cloudflare 域名概述页面右侧获取)
# CLOUDFLARE_ZONE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 具备 Cache Purge 权限的 API Token
# CLOUDFLARE_API_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# [Netlify 全球 CDN 缓存清除]
# Netlify 站点 ID (在 Netlify 控制台 Site configuration 中获取)
# NETLIFY_SITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Netlify Personal Access Token (在 Netlify 用户设置中生成)
# NETLIFY_AUTH_TOKEN="nfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# [Vercel 重新构建与 CDN 全量刷新]
# Vercel Deploy Hook URL (在 Vercel 项目设置 -> Git -> Deploy Hooks 中创建并获取)
# VERCEL_DEPLOY_HOOK_URL="https://api.vercel.com/v1/integrations/deploy/prj_xxxx/xxxx"


